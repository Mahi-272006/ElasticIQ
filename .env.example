# ElasticIQ environment variables.
# Copy this file to .env and adjust values. Never commit the real .env.

# Directory containing the raw M5 CSV files.
ELASTICIQ_RAW_DATA_DIR=data/raw

# Deterministic random seed used by training and simulations.
ELASTICIQ_RANDOM_SEED=42

# Number of product-store series used for the sample training pipeline.
ELASTICIQ_SAMPLE_SERIES=2000

# SQLAlchemy database URL.
# Local development default (SQLite file, no server needed):
ELASTICIQ_DATABASE_URL=sqlite:///E:/ElasticIQ/data/elasticiq.db
# PostgreSQL (requires the psycopg package):
# ELASTICIQ_DATABASE_URL=postgresql+psycopg://elasticiq:elasticiq@localhost:5432/elasticiq

# Comma-separated CORS origins allowed to call the API.
ELASTICIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uvicorn bind settings used by the run scripts.
ELASTICIQ_API_HOST=127.0.0.1
ELASTICIQ_API_PORT=8000
